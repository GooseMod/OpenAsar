{
  "name": "openasar-build",
  "private": true,
  "scripts": {
    "build": "asar pack src app.asar",
    "test": "node --test tests/*.test.js",
    "install:discord": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "discord:multi": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/multi-discord.ps1",
    "uninstall:discord": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1 -Uninstall"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1"
  }
}
